# ==============================================================================
# You Inc. - Environment Variables Template (.env.example)
# Bahi-Khata LMS for MBA Students
# ==============================================================================

# Database: Neon Postgres with pgvector enabled
# Pooled connection string (for queries)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/you_inc?sslmode=require&pgbouncer=true"
# Direct connection string (for Prisma migrations)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/you_inc?sslmode=require"

# Authentication: Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_sample_clerk_key"
CLERK_SECRET_KEY="sk_test_sample_clerk_secret"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# AI Models (Vercel AI SDK)
OPENAI_API_KEY="sk-sample-openai-key"
ANTHROPIC_API_KEY="sk-ant-sample-key"
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSySampleKey"

# Analytics & Monitoring: PostHog
NEXT_PUBLIC_POSTHOG_KEY="phc_sample_posthog_key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Geospatial: MapLibre GL
NEXT_PUBLIC_MAP_STYLE="https://demotiles.maplibre.org/style.json"
MAPLIBRE_API_KEY=""

# Vector & Embedding Config
EMBEDDING_DIMENSION=1536
EMBEDDING_MODEL="text-embedding-3-small"

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
